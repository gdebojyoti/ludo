{
  "installCommand": "npm ci --include-workspace-root",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "rewrites": [{ "source": "/ludo", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/(.*\\.[0-9a-f]{20}\\.js)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/ludo/([0-9a-f]{20}\\.woff2?)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/ludo/([0-9a-f]{20}\\.mp3)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
