# Port the server listens on. Render sets this itself.
PORT=4003
# Addresses of the web app, the only origins allowed to call the server (CORS). Separate several with commas.
WEB_ORIGIN=http://localhost:8083
# Where a Player plays Ludo in a browser, which an AI Player sends them to. Required on Render, where it's
# https://tablehop.games/ludo: the server won't start there without it.
WEB_APP_URL=http://localhost:8083/ludo
# The Postgres database every TableHop game shares, as Ludo's own role, `ludo`, which holds `accounts_reader`. Ludo keeps
# finished Games' results and the Accounts it has seen there, and checks each Player's Session there, as thg.accounts'
# docs/contract.md says. Each time the server starts, it runs the migrations that haven't run yet before it serves
# anything. Required on Render: the server won't start there without it. Locally, see docs/local-database.md; left out,
# results are kept in memory until the server stops, and every Player is a Guest.
#   The session cookie it reads is `__Secure-tablehop.session_token` on Render and `tablehop.session_token` elsewhere,
#   as `accounts` names it in each place, so it needs no setting of its own.
#   On Render: the direct connection string for the `ludo` role on Neon, not the "pooled" one, ending
#   ?sslmode=require. The server keeps its own pool, and a migration holds a lock for its whole connection, which
#   Neon's pooler can't keep.
DATABASE_URL=postgres://ludo:PASSWORD@localhost:5432/accounts
# The local database the server's tests run against, never production: they empty it on every run, so it must be its
# own database, on this machine. `npm test` fails without it. Not used on Render.
TEST_DATABASE_URL=postgres://postgres:PASSWORD@localhost:5432/ludo_test
