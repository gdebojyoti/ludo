{
  "name": "@ludo/server",
  "version": "0.0.0",
  "private": true,
  "description": "The Ludo game server: Express and Socket.IO.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "prebuild": "npm run build -w @ludo/shared",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "migrate": "tsx --env-file-if-exists=.env src/migrate.ts",
    "pretypecheck": "npm run build -w @ludo/shared",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ludo/shared": "*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "engine.io-client": "~6.6.7",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "vitest": "^5.0.4"
  }
}
