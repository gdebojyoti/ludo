{
  "name": "ludo",
  "private": true,
  "description": "Ludo: an online multiplayer board game played between friends.",
  "license": "ISC",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run build -w @ludo/shared && concurrently -k -n shared,server,web -c magenta,blue,green \"npm run dev -w @ludo/shared\" \"npm run dev -w @ludo/server\" \"npm run dev -w @ludo/web\"",
    "build": "npm run build --workspaces",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces --if-present",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "neostandard": "^0.14.1",
    "typescript": "~6.0.3"
  }
}
