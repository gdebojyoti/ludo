{
  "name": "@ludo/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Event types and game rules shared by the Ludo web app and server.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "dev": "tsc -b tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -b tsconfig.build.json && tsc --noEmit",
    "test": "vitest run --dir src"
  },
  "devDependencies": {
    "vitest": "^5.0.4"
  }
}
